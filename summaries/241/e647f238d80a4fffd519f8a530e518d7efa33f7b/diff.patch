+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { KnobsError, loadKnobs, parseKnobs } from '../../keys/knobs.js';
+import { KnobFiles, loadKnobSources } from './knob-files.js';
+
+const shelf = join(import.meta.dirname, '..', '..', '..', 'examples', 'bloom', 'shared', 'instruments');
+const juno = loadKnobs(join(shelf, 'juno.knobs.yaml'));
+
+describe('knob files in a session', () => {
+  let dir: string;
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'field-keys-knobs-'));
+  });
+  afterEach(() => rmSync(dir, { recursive: true, force: true }));
+
+  it('reads a voice’s knob file beside its program, and each named file', () => {
+    writeFileSync(join(dir, 'juno.scd'), '');
+    writeFileSync(join(dir, 'juno.knobs.yaml'), readFileSync(join(shelf, 'juno.knobs.yaml')));
+    writeFileSync(join(dir, 'pad.scd'), '');
+    writeFileSync(join(dir, 'ju-06a.yaml'), 'knobs:\n  - { name: cutoff, cc: 74 }\n');
+    const sources = loadKnobSources(
+      [{ program: join(dir, 'juno.scd'), track: 'creek/keys' }, { program: join(dir, 'pad.scd') }],
+      [join(dir, 'ju-06a.yaml')],
+      undefined,
+    );
+    expect(sources.map(({ name, program }) => ({ name, program }))).toEqual([
+      { name: 'keys', program: join(dir, 'juno.scd') },
+      { name: 'ju-06a', program: undefined },
+    ]);
+    expect(sources[0]!.knobs).toEqual(juno);
+    expect(() => loadKnobSources([], [join(dir, 'missing.yaml')], undefined)).toThrow(/no such file/);
+    writeFileSync(join(dir, 'juno.knobs.yaml'), 'knobs:\n  - { name: cutoff, cc: 1 }\n');
+    expect(() => loadKnobSources([{ program: join(dir, 'juno.scd') }], [], undefined)).toThrow(KnobsError);
+  });
+
+  it('keeps the voice’s copy after a save that fails and asks for no reload, and rewrites it before one that passes', () => {
+    const path = join(dir, 'juno.knobs.yaml');
+    const files = new KnobFiles([
+      { name: 'juno', path, program: '/p/juno.scd', knobs: juno },
+      { name: 'ju-06a', path: join(dir, 'ju-06a.yaml'), knobs: juno.slice(0, 1) },
+    ]);
+    try {
+      const copy = files.copies.get('/p/juno.scd')!;
+      expect(parseKnobs(readFileSync(copy, 'utf8'), copy)).toEqual(juno);
+      expect([...files.copies.keys()]).toEqual(['/p/juno.scd']);
+
+      let failed: KnobsError | undefined;
+      try {
+        parseKnobs('knobs:\n  - { name: res, cc: 1 }\n', path);
+      } catch (err) {
+        failed = err as KnobsError;
+      }
+      expect(files.saved(path, { error: failed! })).toBe(false);
+      expect(files.errors.get(path)).toBe('juno.knobs.yaml: knobs.0.cc: res: cc 1 is the modulation wheel, which is the knob mod');
+      expect(parseKnobs(readFileSync(copy, 'utf8'), copy)).toEqual(juno);
+      expect(files.list().map((k) => k.label)).toContain('juno.release');
+
+      expect(files.saved(path, { knobs: juno.slice(0, 2) })).toBe(true);
+      expect(files.errors.size).toBe(0);
+      expect(parseKnobs(readFileSync(copy, 'utf8'), copy)).toEqual(juno.slice(0, 2));
+      expect(files.list().map((k) => k.label)).toEqual(['mod', 'juno.cutoff', 'juno.res', 'ju-06a.cutoff']);
+
+      // A --knobs file reaches no voice, so its save reloads none.
+      expect(files.saved(join(dir, 'ju-06a.yaml'), { knobs: juno.slice(1, 2) })).toBe(false);
+      expect(files.list().map((k) => k.label)).toEqual(['mod', 'juno.cutoff', 'juno.res', 'ju-06a.res']);
+    } finally {
+      files.remove();
+    }
+    expect(existsSync(files.copies.get('/p/juno.scd')!)).toBe(false);
+  });
+});
diff --git a/src/sc/voice/knob-files.ts b/src/sc/voice/knob-files.ts
new file mode 100644
index 00000000..b85d67ed
--- /dev/null
+++ b/src/sc/voice/knob-files.ts
@@ -0,0 +1,100 @@
+import { existsSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { basename, join } from 'node:path';
+import {
+  knobFileFor,
+  knobFileName,
+  knobList,
+  knobsCopy,
+  loadKnobs,
+  resolveKnobsPath,
+  watchKnobs,
+  type KnobsReload,
+  type ShownKnob,
+} from '../../keys/knobs.js';
+import type { Knob } from '../../schema/knobs.js';
+import type { Voice } from './routing.js';
+
+// A knob file a session reads (instrument-knobs.md §2.2): a voice's, which
+// the voice maps through, or one `field keys --knobs` names, for whatever
+// else listens to Field Keys.
+export interface KnobSource {
+  name: string; // what the knob line puts before its knobs' names
+  path: string;
+  program?: string; // the instrument whose voice reads it
+  knobs: Knob[];
+}
+
+// A session's knob files, and the copies its voices read: each voice
+// reads the copy of its knob file that passed the schema, never the file
+// itself, so a save that fails cannot reach it (instrument-knobs.md §2.4).
+// The copies live in a directory of their own for the session.
+export class KnobFiles {
+  // Each program with a knob file, and the copy its voice reads.
+  readonly copies = new Map<string, string>();
+  // Why the last save of each file did not load, by path.
+  readonly errors = new Map<string, string>();
+  private dir: string | undefined;
+
+  constructor(private readonly sources: KnobSource[]) {
+    sources.forEach((source) => this.write(source));
+  }
+
+  paths(): string[] {
+    return [...new Set(this.sources.map((s) => s.path))];
+  }
+
+  list(): ShownKnob[] {
+    return knobList(this.sources);
+  }
+
+  // A save that passes takes the file's new knobs and rewrites the copy
+  // of each voice that reads it; one that fails changes nothing but its
+  // error. Answers whether a voice reads the file, and so must reload.
+  saved(path: string, result: KnobsReload): boolean {
+    if ('error' in result) {
+      this.errors.set(path, `${basename(path)}: ${result.error.problems[0]}`);
+      return false;
+    }
+    this.errors.delete(path);
+    const changed = this.sources.filter((s) => s.path === path);
+    for (const source of changed) {
+      source.knobs = result.knobs;
+      this.write(source);
+    }
+    return changed.some((s) => s.program !== undefined);
+  }
+
+  watch(onSave: (path: string, result: KnobsReload, reload: boolean) => void): () => void {
+    const stops = this.paths().map((path) => watchKnobs(path, (result) => onSave(path, result, this.saved(path, result))));
+    return () => stops.forEach((stop) => stop());
+  }
+
+  remove(): void {
+    if (this.dir !== undefined) rmSync(this.dir, { recursive: true, force: true });
+  }
+
+  private write({ program, path, knobs }: KnobSource): void {
+    if (program === undefined) return;
+    this.dir ??= mkdtempSync(join(tmpdir(), 'field-knobs-'));
+    const copy = this.copies.get(program) ?? join(this.dir, `${this.copies.size}-${basename(path)}`);
+    writeFileSync(copy, knobsCopy(knobs));
+    this.copies.set(program, copy);
+  }
+}
+
+// The knob file beside each voice's program, where it has one, then each
+// file `specs` names.
+export function loadKnobSources(voices: readonly Voice[], specs: string[], root: string | undefined): KnobSource[] {
+  const sources: KnobSource[] = [];
+  for (const { program, track } of voices) {
+    const path = knobFileFor(program);
+    if (!existsSync(path)) continue;
+    sources.push({ name: track?.split('/').pop() ?? basename(program, '.scd'), path, program, knobs: loadKnobs(path) });
+  }
+  for (const spec of specs) {
+    const path = resolveKnobsPath(spec, root);
+    sources.push({ name: knobFileName(path), path, knobs: loadKnobs(path) });
+  }
+  return sources;
+}
